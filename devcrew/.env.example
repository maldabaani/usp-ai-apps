# DevCrew configuration. Copy to .env and adjust. Never commit .env.

# --- Postgres (docker-compose service) ------------------------------------------------------
POSTGRES_USER=devcrew
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devcrew
POSTGRES_PORT=5432
# SQLAlchemy async URL. docker-compose overrides this for the backend container; this value is
# used when running the backend/alembic directly on the host.
DATABASE_URL=postgresql+asyncpg://devcrew:change-me@localhost:5432/devcrew
# Optional: enables Postgres integration tests (pytest). Use a throwaway database.
# TEST_DATABASE_URL=postgresql+asyncpg://devcrew:change-me@localhost:5432/devcrew_test

# --- Ollama (runs on the host) --------------------------------------------------------------
# From inside docker-compose the host is host.docker.internal; on the host use localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Per-role model settings (model, num_ctx, temperature, num_predict).
MODELS_CONFIG_PATH=config/models.yaml
# Timeout for a single LLM request, in seconds.
LLM_REQUEST_TIMEOUT_S=600

# --- ChromaDB (docker-compose service) ------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000
# Server image tag; keep the major.minor in step with chromadb-client in backend/pyproject.toml.
CHROMA_VERSION=1.5.9

# --- RAG (per-run ChromaDB collection, deleted when the run ends) ---------------------------
RAG_ENABLED=true
# Chunks returned per search / per context section.
RAG_TOP_K=6
# Code-aware chunking: max lines per unit, then line windows with overlap.
RAG_CHUNK_MAX_LINES=120
RAG_WINDOW_LINES=60
RAG_WINDOW_OVERLAP=10
# Files larger than this are not indexed.
RAG_MAX_FILE_BYTES=200000
RAG_EMBED_BATCH_SIZE=32

# --- Execution limits -----------------------------------------------------------------------
# Max concurrent Developer instances AND max concurrent LLM calls (asyncio semaphore).
# Ollama's OLLAMA_NUM_PARALLEL (set on the host) must be >= this value.
MAX_PARALLEL_DEVS=2
# Developer attempts per task (review rejections + test failures) before the Coordinator steps in.
MAX_DEV_ITERATIONS=3
# Max ask_agent/ask_human questions per task (shared budget).
MAX_QUESTIONS_PER_TASK=3
# Max size of a feature request / requirements document in characters. The Planner and
# Architect always get the whole text, so it must fit their context window (~20000 with the
# default num_ctx 16384 in models.yaml; raise both together).
MAX_REQUEST_CHARS=20000
# Quality gates before a PR (run in the sandbox): gitleaks secret scan (always blocking),
# osv-scanner dependency vulnerabilities (new ones only), test coverage (new projects: at
# least GATE_COVERAGE_MIN %; existing repositories: at most GATE_COVERAGE_TOLERANCE points
# below the base branch). A failure gets MAX_GATE_FIX_ROUNDS automatic fix task(s), then you
# decide at the final approval.
GATES_ENABLED=true
GATE_COVERAGE_MIN=70
GATE_COVERAGE_TOLERANCE=0.5
MAX_GATE_FIX_ROUNDS=1
# GitHub automation. Watched repositories are managed in the UI (Settings). The token needs
# Issues, Pull requests and Contents read/write, and Actions read (CI logs).
# After a PR is opened DevCrew follows it (review comments, failed checks, merge conflicts)
# for at most MAX_PR_ROUNDS automatic rounds, until it is merged or closed.
WATCH_PRS=true
MAX_PR_ROUNDS=3
# How often the poller wakes up; each watched repository has its own poll interval.
GITHUB_POLL_TICK_S=30
DEFAULT_POLL_INTERVAL_S=300
# At most this many runs started from issues are active at a time (the rest wait).
MAX_ISSUE_RUNS=2
# Quiet PRs are checked less often: the wait doubles up to this many seconds (0 = every tick).
PR_POLL_MAX_INTERVAL_S=300
# Removing the devcrew label (or closing the issue) cancels its run if the plan is not approved yet.
CANCEL_ON_UNLABEL=true
# Requirements up to MAX_REQUEST_CHARS go to the Planner as they are; longer documents (up to
# MAX_DOCUMENT_CHARS) are condensed part by part, and the Planner can search the full text.
MAX_DOCUMENT_CHARS=200000
# Budgets per run (0 = none). When a run passes one, it stops before the next wave of tasks
# and asks you to continue (the budget grows by the same amount again) or stop. Time counts
# working time only, not time spent waiting for you. The New run form can set other values.
RUN_TOKEN_BUDGET=0
RUN_TIME_BUDGET_MIN=0
# Run the project's tests on the integration branch after every wave of tasks; a failure adds
# a fix task (at most MAX_WAVE_FIX_TASKS per run) that runs before the remaining tasks.
WAVE_TESTS_ENABLED=true
MAX_WAVE_FIX_TASKS=2
# Size limit for the human's chat notes in agent prompts; above it the Coordinator merges them.
MAX_NOTES_CHARS=3000
# Merge-conflict resolution rounds per task before the Coordinator escalates to the human.
MAX_CONFLICT_ROUNDS=2
# Automatic Coordinator decisions (retry/replan/split) per task or node before escalating.
MAX_COORDINATOR_ACTIONS=2

# Max tool-calling steps in one agent turn before it is treated as stuck.
MAX_AGENT_STEPS=30

# --- Agent assets (defaults point into this repo; docker-compose mounts rules/templates) ---
# PROMPTS_DIR=backend/prompts
# RULES_DIR=rules
# TEMPLATES_DIR=templates

# --- Workspaces / sandbox -------------------------------------------------------------------
# ABSOLUTE host path. docker-compose mounts it at the same path in the backend container so
# sandbox bind mounts work. Each run lives in WORKSPACES_DIR/<run_id>/.
WORKSPACES_DIR=/tmp/devcrew/workspaces
# Run commands/tests in Docker sandboxes (false = tests are written but never executed).
SANDBOX_ENABLED=true
# Image names: <prefix>-python|java|node|mixed (build with scripts/build_sandbox_images.sh).
SANDBOX_IMAGE_PREFIX=devcrew-sandbox
# Per-command timeout (seconds) for offline commands, and for the network-enabled
# dependency install step.
SANDBOX_COMMAND_TIMEOUT_S=300
SANDBOX_INSTALL_TIMEOUT_S=900
# Resource limits per sandbox container.
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
SANDBOX_PIDS_LIMIT=1024

# --- GitHub (PR delivery only; pushes happen only after final approval) ---------------------
# Personal access token with `repo` scope (classic) or Contents+Pull requests+Administration
# read/write (fine-grained; Administration only if you use "create repo if missing").
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Where git pushes go (the token is sent as an HTTP header scoped to this host, never in URLs).
GITHUB_GIT_URL=https://github.com
# false = never push or open PRs (e.g. benchmark runs); the run completes after final approval.
GITHUB_DELIVERY_ENABLED=true

# --- Server ---------------------------------------------------------------------------------
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO
# true: refuse to start when DB/Chroma/Ollama/models/Docker are unhealthy (actionable log).
STARTUP_HEALTH_STRICT=true
